# Local development only. Use the same private database/storage passwords and
# encryption key as your local Docker stack. Never copy production credentials.
DATABASE_URL=postgresql://pam:CHANGE_ME@127.0.0.1:5433/pam?schema=public
REDIS_URL=redis://127.0.0.1:6379
APP_ORIGIN=http://localhost:3000
SESSION_COOKIE_SECURE=false
APP_ENCRYPTION_KEY_BASE64="" # Set this value for your installation.
OTP_PEPPER="" # Set this value for your installation.
OTP_PROVIDER=SMTP
OTP_DEV_ALLOWED=false
SMTP_HOST="" # Set this value for your installation.
SMTP_PORT=587
SMTP_USER="" # Set this value for your installation.
SMTP_PASS="" # Set this value for your installation.
OTP_FROM_EMAIL="" # Set this value for your installation.
NOTIFY_FROM_EMAIL="" # Set this value for your installation.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=es-bcn-1
S3_ACCESS_KEY_ID=homehero
S3_SECRET_ACCESS_KEY="" # Set this value for your installation.
S3_BUCKET=pam
S3_FORCE_PATH_STYLE=true
VAPID_PUBLIC_KEY="" # Set this value for your installation.
VAPID_PRIVATE_KEY="" # Set this value for your installation.
VAPID_SUBJECT=mailto:admin@example.com
