# Copy to .env; this template contains no working credentials.
# Use a distinct `openssl rand -hex 32` value for each password/pepper.
POSTGRES_PASSWORD="" # Set this value for your installation.
MINIO_ROOT_USER=homehero
MINIO_ROOT_PASSWORD="" # Set this value for your installation.
S3_BUCKET=pam

# Bootstrap admin: required only for scripts/setup.sh.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD="" # Set this value for your installation.

# Generate with `openssl rand -base64 32`. Keep it stable after storing data.
APP_ENCRYPTION_KEY_BASE64="" # Set this value for your installation.
OTP_PEPPER="" # Set this value for your installation.
APP_ORIGIN=http://localhost:3000
SESSION_COOKIE_SECURE=false

# Employee sign-in and weekly statements require a working SMTP account.
OTP_PROVIDER=SMTP
OTP_DEV_ALLOWED=false
SMTP_HOST="" # Set this value for your installation.
SMTP_PORT=587
SMTP_USER="" # Set this value for your installation.
SMTP_PASS="" # Set this value for your installation.
OTP_FROM_EMAIL="" # Set this value for your installation.
OTP_FROM_NAME=HomeHero
NOTIFY_FROM_EMAIL="" # Set this value for your installation.
NOTIFY_FROM_NAME=HomeHero

# Generate once with the command in README.md; keep keys stable.
VAPID_PUBLIC_KEY="" # Set this value for your installation.
VAPID_PRIVATE_KEY="" # Set this value for your installation.
VAPID_SUBJECT=mailto:admin@example.com

# Secure defaults for a reverse proxy on the Docker host.
# Set bind addresses to the required LAN interface for a remote reverse proxy.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
POSTGRES_PORT=5433
REDIS_PORT=6379
S3_BIND_ADDRESS=127.0.0.1
S3_PORT=9000
S3_CONSOLE_BIND_ADDRESS=127.0.0.1
S3_CONSOLE_PORT=9002
S3_PUBLIC_ENDPOINT=http://localhost:9000
HOMEHERO_IMAGE_TAG=latest
